{
    "name": "dpwd/hpos-compatibility-plugin",
    "description": "Scans plugins for potential HPOS compatibility issues by checking for direct database access or inappropriate WordPress API usage.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "automattic/jetpack-autoloader": "^2.11",
        "yahnis-elsts/plugin-update-checker": "^5.5"
    },
    "require-dev": {
        "woocommerce/woocommerce-sniffs": "*",
        "wp-coding-standards/wpcs": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "*",
        "phpstan/phpstan": "^2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "php-stubs/woocommerce-stubs": "^9.7",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress-no-content": "7.1.1",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "DPWD\\HPOSCompatPlugin\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "!/assets",
            "assets/js/*.map",
            "!/languages",
            "!/vendor",
            "composer.json",
            "composer.lock",
            "package.json",
            "README.md",
            "SECURITY.md",
            "/drafts",
            "version-bump.js",
            ".*",
            "*.yaml",
            "/tests",
            "/tools",
            "phpunit.xml.dist",
            "infection.json5",
            "AGENTS.md",
            "CLAUDE.md"
        ]
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "7.4.33"
        },
        "optimize-autoloader": true
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "phpstan": [
            "./vendor/bin/phpstan analyse --configuration=.phpstan/config.neon"
        ],
        "wpcs": [
            "./vendor/bin/phpcs . --ignore=vendor,.git,assets,node_modules,.phpstan,tests/fixtures,.infection --standard=WooCommerce-Core,WordPress-Core,WordPress-Extra,WordPress-Docs  --report-full --report-summary --colors -s"
        ],
        "wpcs:fix": [
            "./vendor/bin/phpcbf . --ignore=vendor,.git,assets,node_modules,.phpstan,tests/fixtures,.infection --standard=WooCommerce-Core,WordPress-Core,WordPress-Extra,WordPress-Docs  --report-full --report-summary --colors"
        ]
    }
}
